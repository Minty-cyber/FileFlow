<mjml>
  <mj-head>
    <mj-title>Verify Your Email Address</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-style>
      .otp-code {
        letter-spacing: 8px;
        font-weight: bold;
        font-size: 32px;
      }
      .footer-link {
        color: #6b7280;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <!-- Header Section -->
    <mj-section padding="20px 0" background-color="#ffffff">
      <mj-column>
        <mj-image src="https://via.placeholder.com/200x60" alt="Company Logo" width="200px" padding="20px 0" />
      </mj-column>
    </mj-section>
    
    <!-- Main Content Section -->
    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column>
        <mj-text font-size="24px" color="#1f2937" font-weight="bold" padding="20px 0">
          Verify Your Email Address
        </mj-text>
        <mj-text font-size="16px" color="#4b5563" line-height="24px" padding-bottom="10px">
          Thank you for signing up! To complete your registration, please verify your email address by entering the following verification code:
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- OTP Section -->
    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column>
        <mj-text css-class="otp-code" align="center" color="#1f2937" padding="20px 0">
          {{ otp_code }}
        </mj-text>
        <mj-text font-size="14px" color="#6b7280" align="center" padding="0 0 20px 0">
          This verification code will expire in 10 minutes.
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Instructions Section -->
    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column>
        <mj-text font-size="16px" color="#4b5563" line-height="24px" padding="20px 0 10px 0">
          If you did not request this verification code, please ignore this email or contact our support team if you have any concerns.
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Alternate Verification Button -->
    <mj-section background-color="#ffffff" padding="0 20px 30px 20px">
      <mj-column>
        <mj-text font-size="14px" color="#4b5563" align="center" padding-bottom="15px">
          Or verify your account by clicking the button below:
        </mj-text>
        <mj-button background-color="#4f46e5" color="white" border-radius="6px" font-size="16px" font-weight="bold" href="{{ verification_link }}" width="300px">
          Verify Email Address
        </mj-button>
      </mj-column>
    </mj-section>
    
    <!-- Separator -->
    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e5e7eb" padding="0 0 30px 0" />
      </mj-column>
    </mj-section>
    
    <!-- Help Section -->
    <mj-section background-color="#ffffff" padding="0 20px 30px 20px">
      <mj-column>
        <mj-text font-size="14px" color="#6b7280" align="center" line-height="20px">
          If you're having trouble with the verification process, please contact our support team at <a href="mailto:support@example.com" class="footer-link">support@example.com</a>
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Footer Section -->
    <mj-section background-color="#f3f4f6" padding="20px">
      <mj-column>
        <mj-text font-size="12px" color="#9ca3af" align="center" line-height="16px">
          © {{ current_year }} Your Company Name. All rights reserved.
        </mj-text>
        <mj-text font-size="12px" color="#9ca3af" align="center" line-height="16px">
          123 Main Street, City, State, Country
        </mj-text>
        <mj-text font-size="12px" color="#9ca3af" align="center" line-height="16px" padding-top="10px">
          <a href="{{ unsubscribe_link }}" class="footer-link">Unsubscribe</a> • <a href="{{ privacy_policy_link }}" class="footer-link">Privacy Policy</a> • <a href="{{ terms_link }}" class="footer-link">Terms of Service</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>